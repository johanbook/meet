{
  "compilerOptions": {
    "baseUrl": "./",
    "esModuleInterop": true,
    "outDir": "dist",
    "jsx": "react-jsx",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strict": true,
    "target": "ES2022"
  },
  "include": ["src"],
}
